# Gitea 自动化迭代配置
# 复制为 config.env 并填入实际值

# Gitea 配置
GITEA_URL="https://gitea.smalldong.top"
GITEA_API_TOKEN=""
GITEA_OWNER="smalldong"
GITEA_REPO="devops-demo"
GITEA_BRANCH="master"

# Webhook 配置
WEBHOOK_HOST="0.0.0.0"
WEBHOOK_PORT="9876"
WEBHOOK_SECRET=""

# 飞书通知配置
FEISHU_WEBHOOK_URL=""

# Agent 配置
AGENT_WORK_DIR="/root/.picoclaw/workspace/projects/devops-demo"
GIT_USER_NAME="PicoClaw Agent"
GIT_USER_EMAIL="agent@smalldong.top"

# 日志配置
LOG_DIR="/root/.picoclaw/workspace/projects/devops-demo/logs/automation"
STATE_DIR="/root/.picoclaw/workspace/projects/devops-demo/state/automation"
